{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xira.local/schemas/xira-flow-v0.schema.json",
  "title": "Xira Flow Definition v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "objective",
    "entrypoints",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": "xira.flow.v0"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "$ref": "#/$defs/slashAliases"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "inputs": {
      "$ref": "#/$defs/inputSpec"
    },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/flowEntrypoint"
      }
    },
    "context": {
      "$ref": "#/$defs/contextSpec"
    },
    "agents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/agentRef"
      }
    },
    "permissions": {
      "$ref": "#/$defs/permissions"
    },
    "artifacts": {
      "$ref": "#/$defs/artifactPolicy"
    },
    "verification": {
      "$ref": "#/$defs/verification"
    },
    "evolution": {
      "$ref": "#/$defs/evolution"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "^/"
      }
    },
    "template": {
      "type": "string",
      "minLength": 1
    },
    "slashAliases": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^/[A-Za-z0-9][A-Za-z0-9_-]*$"
      },
      "uniqueItems": true
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "inputSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "optional": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      }
    },
    "flowEntrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "start_step"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "type": "string"
        },
        "start_step": {
          "$ref": "#/$defs/id"
        },
        "required_inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "optional_inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "aliases": {
          "$ref": "#/$defs/slashAliases"
        }
      }
    },
    "contextSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "forbidden": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      }
    },
    "agentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "permission_mode": {
          "enum": [
            "observe",
            "ask",
            "trusted-flow",
            "locked"
          ]
        }
      }
    },
    "artifactPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "output_dir": {
          "$ref": "#/$defs/path"
        },
        "retention": {
          "enum": [
            "local",
            "exportable",
            "ephemeral"
          ]
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "acceptance_cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "golden_tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "default_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      }
    },
    "evolution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "candidate_only": {
          "type": "boolean"
        },
        "candidate_dir": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "step": {
      "oneOf": [
        {
          "$ref": "#/$defs/agentStep"
        },
        {
          "$ref": "#/$defs/controlStep"
        }
      ]
    },
    "baseStepProperties": {
      "type": "object",
      "required": [
        "id",
        "objective",
        "output_contract"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "type": "string"
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/template"
          }
        },
        "instructions": {
          "$ref": "#/$defs/stringList"
        },
        "constraints": {
          "$ref": "#/$defs/stringList"
        },
        "required_skills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "preferred_methods": {
          "$ref": "#/$defs/stringList"
        },
        "prompt": {
          "$ref": "#/$defs/promptSpec"
        },
        "output_contract": {
          "$ref": "#/$defs/outputContract"
        },
        "transitions": {
          "$ref": "#/$defs/transitions"
        },
        "retry": {
          "$ref": "#/$defs/retryPolicy"
        }
      }
    },
    "agentStep": {
      "allOf": [
        {
          "$ref": "#/$defs/baseStepProperties"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executor"
          ],
          "properties": {
            "id": true,
            "description": true,
            "objective": true,
            "inputs": true,
            "instructions": true,
            "constraints": true,
            "required_skills": true,
            "preferred_methods": true,
            "prompt": true,
            "executor": {
              "$ref": "#/$defs/agentExecutor"
            },
            "output_contract": true,
            "transitions": true,
            "retry": true
          }
        }
      ]
    },
    "controlStep": {
      "allOf": [
        {
          "$ref": "#/$defs/baseStepProperties"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executor"
          ],
          "properties": {
            "id": true,
            "description": true,
            "objective": true,
            "inputs": true,
            "instructions": true,
            "constraints": true,
            "required_skills": true,
            "preferred_methods": true,
            "prompt": true,
            "executor": {
              "oneOf": [
                {
                  "$ref": "#/$defs/humanApprovalExecutor"
                },
                {
                  "$ref": "#/$defs/decisionExecutor"
                },
                {
                  "$ref": "#/$defs/waitSignalExecutor"
                },
                {
                  "$ref": "#/$defs/subflowExecutor"
                }
              ]
            },
            "output_contract": true,
            "transitions": true,
            "retry": true
          }
        }
      ]
    },
    "agentExecutor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent"
      ],
      "properties": {
        "agent": {
          "$ref": "#/$defs/id"
        },
        "engine_hint": {
          "type": "string"
        }
      }
    },
    "humanApprovalExecutor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "prompt",
        "options"
      ],
      "properties": {
        "type": {
          "const": "human_approval"
        },
        "prompt": {
          "$ref": "#/$defs/template"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "responder": {
          "type": "string",
          "enum": [
            "current_sender",
            "owner"
          ]
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/template"
          }
        }
      }
    },
    "decisionExecutor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "decision"
        }
      }
    },
    "waitSignalExecutor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "signal"
      ],
      "properties": {
        "type": {
          "const": "wait_signal"
        },
        "signal": {
          "type": "string",
          "minLength": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "subflowExecutor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "flow"
      ],
      "properties": {
        "type": {
          "const": "subflow"
        },
        "flow": {
          "$ref": "#/$defs/id"
        },
        "entrypoint": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "promptSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "template": {
          "$ref": "#/$defs/path"
        },
        "inline": {
          "type": "string"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/template"
          }
        }
      }
    },
    "outputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_slots"
      ],
      "properties": {
        "artifact_policy": {
          "enum": [
            "agent_defined",
            "declared_paths",
            "none"
          ]
        },
        "required_slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outputSlot"
          }
        },
        "optional_slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outputSlot"
          }
        },
        "completion_criteria": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "outputSlot": {
      "oneOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "description": {
              "type": "string"
            },
            "formats": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "transitions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on_success": {
          "$ref": "#/$defs/id"
        },
        "on_failure": {
          "$ref": "#/$defs/id"
        },
        "branches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/branch"
          }
        }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "when",
        "next"
      ],
      "properties": {
        "when": {
          "$ref": "#/$defs/template"
        },
        "next": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "on_exhausted": {
          "$ref": "#/$defs/id"
        }
      }
    }
  }
}
